<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Configuración para Android 12+ (API 31+) -->
    <!-- Deshabilita el backup automático de datos en la nube -->
    <cloud-backup>
        <!-- No incluir ningún dominio = deshabilita backup en la nube -->
    </cloud-backup>
    
    <!-- Deshabilita la extracción de datos por ADB y transferencia de dispositivos -->
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="external" path="." />
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>

