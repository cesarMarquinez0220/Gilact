  "tips": {
    "title": "Breastfeeding Tips",
    "progress": "Progress",
    "favorites": "Favorites",
    "tip": "Tip",
    "titles": {
      "complementaryFeeding": "Complementary Feeding",
      "ironSupplementation": "Iron Supplementation",
      "benefitsBaby": "Benefits for the Baby",
      "benefitsMom": "Benefits for the Mom",
      "postureLatch": "Posture and Latch",
      "colostrum": "Colostrum",
      "breastfeedingTips": "Breastfeeding Tips",
      "extractionStorage": "Extraction and Storage",
      "extractionContinuation": "Extraction Continuation",
      "hygiene": "Hygiene in Breastfeeding",
      "hygieneContinuation": "Hygiene Continuation",
      "successfulBreastfeeding": "Successful Breastfeeding",
      "fatherRole": "Father's Role",
      "commonProblems": "Common Problems"
    },
    "content": {
      "complementaryFeeding": "It is recommended to give only breast milk to the baby until 6 months and from this moment, gradually add foods according to the suggestion of the pediatrician or nutritionist. It is recommended to maintain breastfeeding combined with feeding until the mother and child wish.",
      "ironSupplementation": "If your baby had low birth weight and/or is premature, iron supplementation will be provided.\n\n*As indicated by health personnel.",
      "benefitsBaby": {
        "title": "Benefits of Exclusive Breastfeeding",
        "subtitle": "During the first 6 months of life:",
        "items": [
          "Higher IQ and better school performance.",
          "Strengthens love, communication and the emotional bond between mother and child.",
          "More affectionate children.",
          "Fewer dental cavities and better development of facial and neck muscles."
        ]
      },
      "benefitsMom": {
        "items": [
          "Reduces postpartum bleeding.",
          "Helps the uterus return to its normal state.",
          "Protects against ovarian, breast and uterine cancer.",
          "Quickly recovers figure by eliminating fat reserves.",
          "Reduces the risk of postpartum depression."
        ]
      },
      "postureLatch": {
        "title": "Tips for Good Posture and Latch",
        "items": [
          "Place the baby belly to belly and in a straight line, with the face facing the nipple.",
          "The mother should find a comfortable position, using pillows and keeping her back supported.",
          "Proper Latch is Important:",
          "The baby's mouth should be wide open and cover the entire areola (dark area around the nipple)."
        ]
      },
      "colostrum": {
        "title": "Colostrum: The First Milk",
        "intro": "Colostrum is the first milk produced by the mother. Here is key information:",
        "items": [
          "It is yellowish in color and contains high nutritional value.",
          "Satisfies the infant because it has the nutrients the baby needs.",
          "Contains defenses that protect the baby against diseases.",
          "It is the only food the baby needs in the first six months."
        ]
      },
      "breastfeedingTips": {
        "title": "Tips for Successful Breastfeeding",
        "items": [
          "Don't give up! You can breastfeed.",
          "The mother should continue iron and folic acid supplementation during the first 3 months of breastfeeding.",
          "Breastfeed your baby immediately after delivery.",
          "The baby will let you know when hungry, usually nursing 8 to 12 times a day.",
          "Breastfeed in a calm environment.",
          "Find the most comfortable position for breastfeeding.",
          "Drink plenty of water."
        ]
      },
      "extractionStorage": {
        "title": "Extraction, Handling and Storage",
        "intro": "Extraction can be done manually or mechanically. To facilitate extraction, do stimulation by applying warm compresses and circular massages over the entire breast.",
        "items": [
          "Do not mix freshly expressed breast milk with breast milk that is already refrigerated."
        ]
      },
      "extractionContinuation": {
        "title": "Extraction, Handling and Storage of Breast Milk",
        "items": [
          "Thawed milk should be consumed and leftovers discarded.",
          "Leave it at room temperature for a while before giving it.",
          "All containers where milk is placed should be labeled with name and date."
        ]
      },
      "hygiene": {
        "title": "Hygiene and General Measures",
        "items": [
          "Wash your hands well with soap and water before breastfeeding.",
          "Daily bathing is sufficient for nipple hygiene.",
          "Wash your hands with soap and water after each diaper change.",
          "Breastfeed with joy and it will increase your production."
        ]
      },
      "hygieneContinuation": {
        "title": "Your Diet and Breastfeeding",
        "text": "You can eat all kinds of foods. Just make sure to eat healthy and drink plenty of water."
      },
      "successfulBreastfeeding": {
        "title": "Tips for Successful Breastfeeding",
        "items": [
          "Inform yourself and prepare as much as you can about breastfeeding before the time of delivery.",
          "Breastfeed immediately after delivery, this facilitates the start of breastfeeding.",
          "Drink plenty of water.",
          "Trust yourself and your ability to feed your baby: yes, you have milk!",
          "Place the baby frequently on the breast: let them nurse on demand."
        ]
      },
      "fatherRole": {
        "title": "The Father's Role in Breastfeeding",
        "items": [
          "The father figure plays a main role in ensuring and supporting exclusive breastfeeding, for the well-being and full development of the mother and baby.",
